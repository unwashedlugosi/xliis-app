{
  "rewrites": [
    {
      "source": "/bc",
      "destination": "/api/bc"
    },
    {
      "source": "/car",
      "destination": "/api/car"
    }
  ],
  "headers": [
    {
      "source": "/firmware/core2/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/firmware/core2/releases/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Content-Type",
          "value": "application/octet-stream"
        }
      ]
    }
  ]
}
